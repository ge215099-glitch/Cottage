{
  "name": "cottage-next",
  "private": true,
  "version": "0.2.1",
  "description": "Cottage Next — 本地优先的 AI 角色聊天",
  "author": "Cottage",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "launch": "node scripts/launch-dev.mjs",
    "shortcut": "node scripts/create-desktop-shortcut.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-electron.mjs",
    "smoke:dev": "node scripts/verify-dev-server.mjs",
    "smoke:launcher": "node scripts/smoke-launcher.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:packaged:launch": "node scripts/smoke-packaged.mjs --launch --installer",
    "package:win": "node scripts/package-win.mjs",
    "package:win:dir": "node scripts/package-win.mjs --dir",
    "postinstall": "node scripts/rebuild-native.mjs --quiet",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:all": "npm run verify && npm run smoke:dev && npm run smoke"
  },
  "dependencies": {
    "@langchain/core": "1.3.4",
    "@langchain/langgraph": "1.7.5",
    "better-sqlite3": "11.10.0",
    "gpt-tokenizer": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@floating-ui/react": "0.27.5",
    "@tanstack/react-virtual": "3.13.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "34.3.3",
    "electron-builder": "26.12.0",
    "electron-vite": "3.0.0",
    "jsdom": "26.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "9.0.3",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.7",
    "zustand": "5.0.3"
  }
}
